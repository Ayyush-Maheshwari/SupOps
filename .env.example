# --- LLM provider (OpenAI-compatible chat completions) -----------------------
# Gemini free tier (default). Get a key at https://aistudio.google.com/apikey
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
LLM_CLASSIFIER_MODEL=gemini-3.5-flash-lite

# Local (later): point the same adapter at Ollama and restart.
#   LLM_BASE_URL=http://localhost:11434/v1/
#   LLM_API_KEY=ollama
#   LLM_MODEL=qwen3:8b

# --- Platform ---------------------------------------------------------------
PORT=3001
DATABASE_PATH=./data/supops.db
# 32-byte key, base64. Generate: openssl rand -base64 32
SUPOPS_MASTER_KEY=
JWT_SECRET=
# Max concurrent agent runs. Keep at 1 on a free tier or a local model.
RUN_CONCURRENCY=1
